{
  "name": "code-shame",
  "version": "0.2.1",
  "description": "Local web dashboard for Fallow code analysis reports.",
  "main": "src/server.js",
  "bin": {
    "code-shame": "src/start.js"
  },
  "files": [
    "assets",
    "public",
    "src",
    "ARCHITECTURE.md",
    "README.md"
  ],
  "scripts": {
    "dev": "node src/start.js",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "fallow",
    "code-analysis",
    "code-shame",
    "dashboard",
    "maintainability",
    "dead-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idesiatkova/code-shame.git"
  },
  "bugs": {
    "url": "https://github.com/idesiatkova/code-shame/issues"
  },
  "homepage": "https://github.com/idesiatkova/code-shame#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cytoscape": "3.34.0",
    "fallow": "3.31.0",
    "lucide": "1.21.0",
    "minimatch": "10.2.5"
  }
}
